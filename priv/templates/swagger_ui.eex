<!-- Swagger UI 5.32.14 - adapted from dist/index.html + dist/swagger-initializer.js -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Swagger UI</title>
    <link rel="stylesheet" type="text/css" href="<%= uri %>/swagger-ui.css" />
    <link rel="stylesheet" type="text/css" href="<%= uri %>/index.css" />
    <link rel="icon" type="image/png" href="<%= uri %>/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="<%= uri %>/favicon-16x16.png" sizes="16x16" />
  </head>

  <body>
    <div id="swagger-ui"></div>

    <script src="<%= uri %>/swagger-ui-bundle.js" charset="UTF-8"></script>
    <script src="<%= uri %>/swagger-ui-standalone-preset.js" charset="UTF-8"></script>
    <script>
      window.onload = function() {
        window.ui = SwaggerUIBundle({
          url: "<%= file %>",
          dom_id: '#swagger-ui',
          deepLinking: true,
          oauth2RedirectUrl: "<%= uri %>/oauth2-redirect.html",
          presets: [
            SwaggerUIBundle.presets.apis
          ],
          plugins: [
            SwaggerUIBundle.plugins.DownloadUrl
          ]
        })
      }
    </script>
  </body>
</html>
